# Root-owned shell configuration, mode 0600. Never commit real values.
ITD_USER=itd-studio
ITD_HOME=/var/lib/itd-studio
ITD_APP_DIR=/opt/itd-studio/current
ITD_BACKUP_DIR=/var/lib/itd-studio/backups
ITD_SERVICE=itd-studio.service
# External repository configured separately by the operator; no service is connected.
RESTIC_REPOSITORY='REPLACE_WITH_EXTERNAL_REPOSITORY'
RESTIC_PASSWORD_FILE=/etc/itd-studio/restic-password
# Optional provider credentials file: root-owned 0600, shell export statements.
# RESTIC_CREDENTIALS_FILE=/etc/itd-studio/storage-credentials
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
KEEP_LOCAL=2
