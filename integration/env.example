# Только на сервере, не в Tilda и не в публичной папке.
# Адрес получите из Custom Webhook Make; не добавляйте его в Git.
MAKE_WEBHOOK_URL=
# Отдельный постоянный файл метаданных, НЕ база личного кабинета.
ITD_FORMS_DB=/private/itd-forms/submissions.sqlite
PORT=8081
# Включить только с локальным Caddy, который перезаписывает X-Real-IP.
ITD_TRUST_LOCAL_PROXY=1
